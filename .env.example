POSTGRES_USER=payments
POSTGRES_PASSWORD=payments-local-password
POSTGRES_DB=payments
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=rabbit-local-password
DATABASE_URL=postgresql+asyncpg://payments:payments-local-password@postgres:5432/payments
RABBITMQ_URL=amqp://payments:rabbit-local-password@rabbitmq:5672/
API_KEY=local-demo-api-key-change-me
WEBHOOK_SECRET=local-demo-webhook-secret-change-me
WEBHOOK_ALLOWED_ORIGINS=["http://webhook:8080"]
WEBHOOK_TIMEOUT=5
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
RETRY_BASE_DELAY=2
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=20
PUBLISH_TIMEOUT=5
CONSUMER_PREFETCH=10
DATABASE_POOL_SIZE=15
LOG_LEVEL=INFO
